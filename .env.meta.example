# ==============================================================================
# META (FACEBOOK) ADS CONFIGURATION
# ==============================================================================
#
# Instructions:
# 1. Copy this file to .env.meta: cp .env.meta.example .env.meta
# 2. Fill in your actual Meta credentials below
# 3. Never commit .env.meta to git (it's in .gitignore)
#
# ==============================================================================

# Meta App Credentials
# Get these from: https://developers.facebook.com/apps
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here

# Access Token
# Generate from: https://developers.facebook.com/tools/explorer
# For long-lived tokens (60 days): Use token exchange API
# For never-expiring tokens: Create System User in Business Manager
META_ACCESS_TOKEN=your_long_lived_access_token_here

# Ad Account ID
# Format: act_123456789 (must include "act_" prefix)
# Find in: https://adsmanager.facebook.com (check URL)
# Or: https://business.facebook.com/settings/ad-accounts
META_AD_ACCOUNT_ID=act_123456789

# Internal Customer ID
# This links the Meta ad account to your internal customer record
# Usually 1 for single-customer setups
# For multi-customer: Use the customer_id from your customers table
CUSTOMER_ID=1

# API Version (optional)
# Default: Latest stable version
# Format: v19.0
META_API_VERSION=v19.0

# ==============================================================================
# NOTES
# ==============================================================================
#
# Token Types:
# - User Access Token (60 days): Quick for testing
# - System User Token (never expires): Recommended for production
#
# Required Permissions:
# - ads_read: Read ads data
# - ads_management: Manage ads (required for full access)
# - read_insights: Read performance metrics
#
# Security:
# - Keep META_APP_SECRET secure (never share)
# - Rotate META_ACCESS_TOKEN periodically
# - Use System User tokens for production
# - Enable 2FA on your Facebook account
#
# ==============================================================================
