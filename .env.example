# ============================================
# Google Ads API Configuration
# ============================================
# Get these from: https://ads.google.com/aw/apicenter and https://console.cloud.google.com

# Developer Token (from Google Ads API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# OAuth2 Credentials (from Google Cloud Console)
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here

# Refresh Token (generate using generate_refresh_token.py script)
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here

# Customer ID (10 digits, no dashes - from Google Ads account)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# ============================================
# API Configuration
# ============================================
API_VERSION=v1
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=sqlite:///./google_ads_data.db

# ============================================
# CORS Configuration (for frontend)
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# ============================================
# Pagination Settings
# ============================================
PAGINATION_DEFAULT_LIMIT=100
PAGINATION_MAX_LIMIT=1000

# ============================================
# AI Services Configuration
# ============================================
# Google Gemini API (for text generation)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (for DALL-E 3 image generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here