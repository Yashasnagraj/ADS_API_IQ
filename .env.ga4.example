# ============================================================================
# Google Analytics 4 (GA4) Configuration
# ============================================================================
#
# This file contains configuration for connecting to your GA4 property
# Copy this file to .env.ga4 and fill in your actual values
#
# IMPORTANT: Never commit .env.ga4 to version control!
# Add it to .gitignore to keep credentials secure
#
# ============================================================================

# GA4 Property ID
# Find this in Google Analytics:
# 1. Go to https://analytics.google.com
# 2. Click Admin → Property Settings
# 3. Copy the Property ID (e.g., 123456789)
#
# Example: GA4_PROPERTY_ID=123456789
GA4_PROPERTY_ID=YOUR_PROPERTY_ID_HERE

# Path to Service Account JSON Key File
# This is the JSON file downloaded from Google Cloud Console
# Use absolute path (not relative)
#
# Example: GA4_CREDENTIALS_PATH=D:\ADS_API\credentials\ga4-service-account.json
GA4_CREDENTIALS_PATH=D:\ADS_API\credentials\ga4-service-account.json

# Your Internal Customer ID
# This links GA4 data to your customer in the database
# Usually 1 for single customer, or specific customer_id for multi-customer
#
# Example: CUSTOMER_ID=1
CUSTOMER_ID=1

# ============================================================================
# Setup Instructions:
# ============================================================================
#
# 1. Get GA4 Property ID from Google Analytics (see above)
#
# 2. Create Service Account in Google Cloud Console:
#    a. Go to https://console.cloud.google.com
#    b. Enable "Google Analytics Data API"
#    c. Create Service Account with "Viewer" role
#    d. Download JSON key file
#
# 3. Grant Service Account access to GA4:
#    a. Go to GA4 Admin → Property Access Management
#    b. Add service account email with "Viewer" role
#
# 4. Place JSON key file in credentials/ folder
#
# 5. Copy this file to .env.ga4 and fill in values
#
# 6. Run setup: python setup_ga4.py
#
# 7. Run ETL: python ga4_etl.py
#
# ============================================================================
